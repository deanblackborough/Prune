{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-asan",
      "displayName": "x64 Debug + Sanitizers",
      "inherits": "x64-debug",
      "cacheVariables": {
        "PRUNE_SANITIZE": "ON"
      }
    },
    {
      "name": "mac-debug",
      "displayName": "macOS Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug-build",
      "displayName": "x64 Debug Build",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release-build",
      "displayName": "x64 Release Build",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-asan-build",
      "displayName": "x64 Debug + Sanitizers Build",
      "configurePreset": "x64-asan"
    },
    {
      "name": "mac-debug-build",
      "displayName": "macOS Debug Build",
      "configurePreset": "mac-debug"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug-test",
      "displayName": "x64 Debug Tests",
      "configurePreset": "x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release-test",
      "displayName": "x64 Release Tests",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-asan-test",
      "displayName": "x64 Debug + Sanitizers Tests",
      "configurePreset": "x64-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mac-debug-test",
      "displayName": "macOS Debug Tests",
      "configurePreset": "mac-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
